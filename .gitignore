*.parquet
*.feather
*.h5
*.pkl
*.joblib
*.csv
*.jsonl
*.ndjson
# keep directory placeholders
!**/.gitkeep

# --- Reports (large outputs) ---
reports/calibration/
reports/backtests/
reports/paper/
*.html

# --- Zero-key demo sample (curated inputs + reference reports ARE committed) ---
# Overrides the broad *.jsonl / *.csv ignores above for the small committed sample;
# regenerated pipeline outputs (models/datasets, demo report dir) stay ignored.
!sample_data/**
sample_data/models/
sample_reports/

# --- Logs ---
logs/
*.log

# --- Python build / cache ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Virtualenvs ---
.venv/
venv/
env/
ENV/

# --- Editor / OS ---
