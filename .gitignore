# --- Secrets / local config ---
.env
.env.*
!.env.example
*.local.yaml
config/live.yaml
secrets/
*.key
*.pem

# --- Data & artifacts ---
data/raw/
data/normalized/
data/features/
data/labels/
data/models/
data/audit/                 # live-readiness dry-run audit logs (no secrets, but local-only)
data/decisions/
data/paper/
