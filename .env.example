# ==========================================================================
# btc5m — environment template (PRIMARY venue: Kalshi BTC 15m, series KXBTC15M)
# Copy to `.env` and fill in locally. NEVER commit `.env`. NEVER paste secrets
# into chat. Seed phrases / private keys are NOT used or requested here.
# ==========================================================================

# --- Trading mode & safety gates (keep these defaults for safe operation) ---
TRADING_MODE=paper                 # offline | record-only | backtest | paper | live
LIVE_TRADING_ENABLED=false         # must be true (plus all gates) to ever go live
REQUIRE_MANUAL_CONFIRMATION=true   # require explicit confirmation before live orders
KILL_SWITCH_ENABLED=true           # true = reject all orders (safe default)

# --- Kalshi (PRIMARY venue) ---
# PUBLIC market-data REST needs NO credentials (discovery/recording/readiness all
# work without keys). KEY_ID + PRIVATE_KEY_PATH are only needed for authenticated
# WebSocket / account / (later) live trading. Keep the private key in a local file
# (gitignored); never paste it into chat. KALSHI_PRIVATE_KEY_PASSPHRASE optional.
KALSHI_ENV=prod
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_SERIES_TICKER=KXBTC15M
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY_PASSPHRASE=
# Kalshi fee assumptions (ASSUMED until verified against the official schedule).
KALSHI_FEE_RATE=0.07               # round_up_cent(rate * contracts * price * (1 - price))
KALSHI_FEE_STATUS=ASSUMED          # OFFICIAL | ASSUMED | UNKNOWN

# --- Low-latency hot path (5-minute-grade architecture; SAFE/paper-only) ---
# All OFF/safe by default. The hot path is in-memory/event-driven and can NEVER
# submit live orders. WebSocket is used only if enabled AND Kalshi auth is present
# (else REST polling fallback). Horizon knobs make 15m-now / 5m-later config-driven.
KALSHI_LOW_LATENCY_ENABLED=false
KALSHI_USE_WEBSOCKET=false          # requires KALSHI_KEY_ID + KALSHI_PRIVATE_KEY_PATH; else REST fallback
KALSHI_REST_FALLBACK_ENABLED=true
KALSHI_HOTPATH_SCORE_INTERVAL_MS=250
KALSHI_MAX_BOOK_AGE_MS=1000         # reject decisions on a book older than this
KALSHI_MAX_UNDERLYING_AGE_MS=2000   # reject decisions on stale BTC underlying
KALSHI_MAX_DERIBIT_AGE_MS=180000    # Deribit is optional context; loose freshness
KALSHI_HOTPATH_PROFILE=false
KALSHI_HOTPATH_LOG_EVERY_N=100
KALSHI_HOTPATH_PAPER_ONLY=true      # hot path is paper-only; live is impossible regardless
KALSHI_ORDER_PLANNING_ENABLED=false # generate PLANNED (never submitted) order objects
KALSHI_ALLOWED_TIME_IN_FORCE=fill_or_kill,immediate_or_cancel
# Horizon (config-driven; KXBTC15M now, KXBTC5M-style later — same code path):
KALSHI_MARKET_DURATION_SECONDS=900
KALSHI_MIN_SECONDS_TO_CLOSE=10
KALSHI_MAX_SECONDS_TO_CLOSE=900
KALSHI_MIN_DEPTH=1
KALSHI_MIN_NET_EDGE_CENTS=2

# --- Calibration + executable backtest (RESEARCH ONLY; never trades) ---
# Gated on DISTINCT feature-backed official 15m windows. Backtest uses executable
# ASK prices (never midpoint), fees, depth, staleness. Below-gate runs require
# per-command --diagnostic-only (or KALSHI_BACKTEST_ALLOW_DIAGNOSTIC=true) and are
# stamped NON_TRADABLE_DIAGNOSTIC_ONLY. Nothing here emits PAPER_CANDIDATE.
KALSHI_BACKTEST_MIN_WINDOWS=60
KALSHI_TRAIN_MIN_WINDOWS=150
KALSHI_CALIBRATION_MIN_WINDOWS=150
KALSHI_BACKTEST_DEFAULT_SIZE=1
KALSHI_BACKTEST_MIN_NET_EDGE_CENTS=2
KALSHI_BACKTEST_MAX_BOOK_AGE_MS=1000
KALSHI_BACKTEST_MAX_UNDERLYING_AGE_MS=2000
KALSHI_BACKTEST_MIN_SECONDS_TO_CLOSE=5
KALSHI_BACKTEST_MAX_SECONDS_TO_CLOSE=900
KALSHI_BACKTEST_ALLOW_DIAGNOSTIC=false
KALSHI_BACKTEST_USE_DERIBIT_FILTERS=false

# --- Paper-candidate policy (CONSERVATIVE; disabled by default; NEVER live) ---
# The policy decides WATCH / MANUAL_REVIEW / REJECTED / PAPER_CANDIDATE from the
# calibrated probability + executable ASK EV + freshness/depth/spread/time/risk
# gates. PAPER_CANDIDATE is only possible when ENABLED *and* a trained + calibrated
# + non-diagnostic + sufficiently-backtested model passes every gate. No live order
# is ever submitted; a hard Up/Down class alone never trades.
KALSHI_PAPER_POLICY_ENABLED=false
KALSHI_REQUIRE_TRAINED_MODEL=true
KALSHI_REQUIRE_CALIBRATED_MODEL=true
KALSHI_REQUIRE_BACKTEST_EVIDENCE=true
KALSHI_REQUIRE_NON_DIAGNOSTIC_MODEL=true
KALSHI_MIN_CALIBRATION_WINDOWS=150
KALSHI_MIN_RAW_EDGE_CENTS=3
# (shares KALSHI_MIN_NET_EDGE_CENTS / KALSHI_MIN_BACKTEST_WINDOWS / KALSHI_UNCERTAINTY_BUFFER_CENTS
#  / KALSHI_MAX_*_AGE_MS / KALSHI_MIN_SECONDS_TO_CLOSE / KALSHI_MAX_SECONDS_TO_CLOSE with the blocks above)
KALSHI_MAX_YES_PRICE_CENTS=95
KALSHI_MAX_NO_PRICE_CENTS=95
KALSHI_MAX_SPREAD_CENTS=10
KALSHI_MIN_TOP_DEPTH_CONTRACTS=1
KALSHI_MAX_TRADES_PER_WINDOW=1
KALSHI_MAX_OPEN_POSITIONS=1
KALSHI_PAPER_DEFAULT_SIZE=1
KALSHI_ALLOW_DIAGNOSTIC_PAPER=false
KALSHI_REQUIRE_DERIBIT_FRESH=false
KALSHI_NOTIFY_PAPER_CANDIDATES=true

# --- PAPER-ONLY artifact promotion + shadow/paper runtime (NEVER live) ---
# The runtime loads model/calibrator ONLY from an explicit paper-promotion manifest
# (data/models/paper_promoted/kalshi_paper_promotion_manifest.json) — never "newest
# .pkl by mtime", never a staged artifact, never a diagnostic/uncalibrated one.
# KALSHI_MODEL_RUNTIME_MODE: disabled | shadow | paper ("live" is never accepted).
#   disabled = no model-driven paper candidates (default, safest).
#   shadow   = score + log SHADOW_DECISION only; NEVER emits PAPER_CANDIDATE / fills.
#   paper    = may emit PAPER_CANDIDATE + simulate fills IF every gate passes.
# Promote/demote are explicit CLI commands; this prompt never auto-promotes.
KALSHI_MODEL_RUNTIME_MODE=disabled
KALSHI_PAPER_PROMOTION_REQUIRED=true
KALSHI_REQUIRE_PROMOTED_PAPER_MODEL=true
KALSHI_REQUIRE_EDGE_POLICY=true
KALSHI_REQUIRE_FREQUENCY_REPORT=true
# Conservative trade-rate caps (Part G). Never loosen these just to get trades.
KALSHI_MAX_DAILY_TRADES=10
KALSHI_ENTRY_COOLDOWN_SECONDS=30
# Documentation-only: live submission is hard-disabled in code regardless of this value.
KALSHI_LIVE_SUBMISSION_ALLOWED=false

# --- Controlled PAPER experiment (shadow first, paper only after preflight; NEVER live) ---
# A disciplined harness to run the PROMOTED paper model in SHADOW (score+log, no fills)
# and then PAPER (gated fills) only if preflight passes. Defaults are safe: disabled,
# shadow, promoted model required, diagnostic rejected, strict source freshness,
# conservative trade frequency, explicit abort criteria. live is never honored.
KALSHI_PAPER_EXPERIMENT_ENABLED=false
KALSHI_PAPER_EXPERIMENT_MODE=shadow          # disabled | shadow | paper (never live)
KALSHI_PAPER_EXPERIMENT_NAME=
KALSHI_PAPER_EXPERIMENT_MAX_DURATION_MINUTES=360
KALSHI_PAPER_EXPERIMENT_MAX_DAILY_TRADES=10
KALSHI_PAPER_EXPERIMENT_MAX_TRADES_PER_WINDOW=1
KALSHI_PAPER_EXPERIMENT_MAX_OPEN_POSITIONS=1
KALSHI_PAPER_EXPERIMENT_DEFAULT_SIZE=1
KALSHI_PAPER_EXPERIMENT_MIN_NET_EDGE_CENTS=5
KALSHI_PAPER_EXPERIMENT_MIN_FINAL_EDGE_CENTS=2
KALSHI_PAPER_EXPERIMENT_MIN_RAW_EDGE_CENTS=5
KALSHI_PAPER_EXPERIMENT_COOLDOWN_SECONDS=30
KALSHI_PAPER_EXPERIMENT_MIN_SECONDS_TO_CLOSE=10
KALSHI_PAPER_EXPERIMENT_MAX_SECONDS_TO_CLOSE=900
KALSHI_PAPER_EXPERIMENT_MAX_BOOK_AGE_MS=1000
KALSHI_PAPER_EXPERIMENT_MAX_UNDERLYING_AGE_MS=5000
KALSHI_PAPER_EXPERIMENT_MAX_DERIBIT_AGE_MS=180000
KALSHI_PAPER_EXPERIMENT_REQUIRE_PROMOTED_MODEL=true
KALSHI_PAPER_EXPERIMENT_REQUIRE_CALIBRATOR=true
KALSHI_PAPER_EXPERIMENT_REQUIRE_EDGE_POLICY=true
KALSHI_PAPER_EXPERIMENT_REQUIRE_SOURCE_FRESHNESS=true
KALSHI_PAPER_EXPERIMENT_REQUIRE_BACKTEST_REPORT=true
KALSHI_PAPER_EXPERIMENT_ALLOW_DIAGNOSTIC=false
KALSHI_PAPER_EXPERIMENT_ALLOW_LIVE=false      # documentation-only; never honored
KALSHI_PAPER_EXPERIMENT_ABORT_ON_SOURCE_STALE=true
KALSHI_PAPER_EXPERIMENT_ABORT_ON_MODEL_ERROR=true
KALSHI_PAPER_EXPERIMENT_ABORT_ON_POLICY_ERROR=true
KALSHI_PAPER_EXPERIMENT_ABORT_ON_UNEXPECTED_LIVE_ENABLED=true
KALSHI_PAPER_EXPERIMENT_MAX_CONSECUTIVE_REJECTIONS=100
KALSHI_PAPER_EXPERIMENT_MAX_DRAWDOWN_CENTS=100
KALSHI_PAPER_EXPERIMENT_MAX_DAILY_PAPER_LOSS_CENTS=100

# --- Post-entry lock-profit module (paper-only; disabled by default; NEVER live) ---
# POSITION MANAGEMENT after a paper entry — NOT a flat-position arb scanner. It only
# evaluates buying the OPPOSITE leg of an EXISTING paper position to lock guaranteed
# profit after fees (held YES -> monitor NO; held NO -> monitor YES). It never opens
# directional positions, never scans flat markets, and never submits a live order.
KALSHI_LOCK_MODULE_ENABLED=false
KALSHI_LOCK_PAPER_ONLY=true
KALSHI_LOCK_MIN_PROFIT_CENTS=2
KALSHI_LOCK_HARD_PROFIT_CENTS=5
KALSHI_LOCK_ALLOW_PARTIAL=false
KALSHI_LOCK_DEFAULT_MODE=fok          # fok | ioc (partial only with ioc + allow_partial)
KALSHI_LOCK_MAX_BOOK_AGE_MS=1000
KALSHI_LOCK_MAX_UNDERLYING_AGE_MS=2000
KALSHI_LOCK_MIN_DEPTH_CONTRACTS=1
KALSHI_LOCK_MIN_SECONDS_TO_CLOSE=3
KALSHI_LOCK_RIDE_MIN_EDGE_CENTS=3
KALSHI_LOCK_FORCE_WHEN_MODEL_EDGE_BELOW_CENTS=1
KALSHI_LOCK_REQUIRE_UNDERLYING_FRESH=false
KALSHI_LOCK_NOTIFY=true

# --- Post-entry position lifecycle manager (paper-only; POST-ENTRY ONLY) ---
# Monitors EXISTING paper positions and compares same-leg sell vs opposite-leg
# lock vs updated continue/ride EV. Never opens positions, never scans flat
# markets, never submits a live order. Thresholds in cents.
KALSHI_POSITION_LIFECYCLE_ENABLED=false
KALSHI_POSITION_LIFECYCLE_PAPER_ONLY=true
KALSHI_LIFECYCLE_MIN_SELL_PROFIT_CENTS=2
KALSHI_LIFECYCLE_HARD_SELL_PROFIT_CENTS=5
KALSHI_LIFECYCLE_MIN_LOCK_PROFIT_CENTS=2
KALSHI_LIFECYCLE_HARD_LOCK_PROFIT_CENTS=5
KALSHI_LIFECYCLE_RIDE_MIN_EDGE_CENTS=3
KALSHI_LIFECYCLE_FORCE_EXIT_WHEN_MODEL_EDGE_BELOW_CENTS=0
KALSHI_LIFECYCLE_FORCE_LOCK_WHEN_MODEL_EDGE_BELOW_CENTS=1
KALSHI_LIFECYCLE_ALLOW_PARTIAL_EXIT=false
KALSHI_LIFECYCLE_ALLOW_PARTIAL_LOCK=false
KALSHI_LIFECYCLE_DEFAULT_TIF=fill_or_kill
KALSHI_LIFECYCLE_MAX_BOOK_AGE_MS=1000
KALSHI_LIFECYCLE_MAX_UNDERLYING_AGE_MS=2000
KALSHI_LIFECYCLE_MIN_DEPTH_CONTRACTS=1
KALSHI_LIFECYCLE_MIN_SECONDS_TO_CLOSE=3
KALSHI_LIFECYCLE_MAX_SPREAD_CENTS=10
KALSHI_LIFECYCLE_NOTIFY=true

# --- Trade-frequency frontier / overtrading ANALYSIS (research/reporting only) ---
# Score constantly, trade selectively: frequency is earned from marginal net edge,
# not guessed. Never trades, never promotes a policy, never enables live.
KALSHI_FREQUENCY_ANALYSIS_ENABLED=true
KALSHI_FREQ_DEFAULT_MAX_SCENARIOS=250
KALSHI_FREQ_MIN_NET_EDGE_GRID_CENTS=1,2,3,5,7,10
KALSHI_FREQ_MAX_TRADES_PER_WINDOW_GRID=1,2,3,5
KALSHI_FREQ_COOLDOWN_GRID_SECONDS=0,5,15,30,60
KALSHI_FREQ_MIN_SECONDS_TO_CLOSE_GRID=5,15,30,60,120
KALSHI_FREQ_REPORT_TOP_N=5,10,20,50,100
KALSHI_FREQ_DO_NOT_PROMOTE=true

# --- Confidence-aware EDGE THRESHOLD / reservation-price policy (paper-only) ---
# Do NOT trade just because model_prob > price. Trade only when the CONSERVATIVE
# edge survives fees + depth + staleness + model/calibration/regime/overtrading
# buffers + a minimum profit buffer. Conservative by default; never promotes; no live.
KALSHI_EDGE_POLICY_ENABLED=true
KALSHI_EDGE_REQUIRE_CONFIDENCE_BOUNDS=true
KALSHI_EDGE_MIN_RAW_EDGE_CENTS=5
KALSHI_EDGE_MIN_FINAL_EDGE_CENTS=2
KALSHI_EDGE_BASE_MIN_PROFIT_CENTS=2
KALSHI_EDGE_FIXED_UNCERTAINTY_BUFFER_CENTS=3
KALSHI_EDGE_MIN_CALIBRATION_BUCKET_N=30
KALSHI_EDGE_CONFIDENCE_LEVEL=0.80
KALSHI_EDGE_MAX_PROB_INTERVAL_WIDTH_CENTS=12
KALSHI_EDGE_USE_CALIBRATION_BUCKETS=true
KALSHI_EDGE_USE_WINDOW_BOOTSTRAP=false
KALSHI_EDGE_BOOTSTRAP_SAMPLES=500
KALSHI_EDGE_USE_ENSEMBLE_DISAGREEMENT=true
KALSHI_EDGE_MAX_MODEL_DISAGREEMENT_CENTS=10
KALSHI_EDGE_STALE_QUOTE_BUFFER_CENTS=1
KALSHI_EDGE_SOURCE_STALE_BUFFER_CENTS=2
KALSHI_EDGE_HIGH_VOL_REGIME_BUFFER_CENTS=2
KALSHI_EDGE_THIN_BOOK_BUFFER_CENTS=2
KALSHI_EDGE_OVERTRADING_BUFFER_CENTS=1
KALSHI_EDGE_MIN_BOOK_DEPTH=1
KALSHI_EDGE_MAX_SPREAD_CENTS=10
KALSHI_EDGE_MAX_BOOK_AGE_MS=1000
KALSHI_EDGE_MAX_UNDERLYING_AGE_MS=2000
KALSHI_EDGE_REPORT_BREAKDOWN=true

# --- Live-readiness scaffolding (SAFE/LOCKED by default; NEVER submits) ---
# Prompt 7 makes the live path INSPECTABLE in dry-run only. Live submission is
# impossible here: dry-run-only on, submit disabled, kill switch on, manual confirm
# required, no market orders, tiny limits, model/calibrator/backtest/paper evidence
# required. Enabling live is a SEPARATE future step. NEVER put real keys in .env that
# you commit; the RSA private key lives in a gitignored local file referenced by path.
KALSHI_LIVE_READINESS_ENABLED=false   # turn on the readiness REPORT (still no submit)
KALSHI_LIVE_DRY_RUN_ONLY=true
KALSHI_LIVE_SUBMIT_ENABLED=false
KALSHI_LIVE_ALLOW_PRIVATE_READS=false # read-only private endpoints (none implemented yet)
# KALSHI_KEY_ID / KALSHI_PRIVATE_KEY_PATH are defined in the Kalshi section above.
# KALSHI_API_BASE_URL / KALSHI_WEBSOCKET_URL are accepted aliases for KALSHI_API_BASE / KALSHI_WS_URL.
KALSHI_MAX_LIVE_ORDER_SIZE=1
KALSHI_MAX_LIVE_NOTIONAL=10
KALSHI_MAX_LIVE_DAILY_LOSS=10
KALSHI_MAX_LIVE_OPEN_EXPOSURE=10
KALSHI_REQUIRE_APPROVED_MODEL=true
KALSHI_REQUIRE_VALID_CALIBRATOR=true
KALSHI_REQUIRE_VALID_BACKTEST=true
KALSHI_REQUIRE_PAPER_EVIDENCE=true
KALSHI_REQUIRE_SOURCE_HEALTH=true
KALSHI_REQUIRE_FRESH_BOOK=true
KALSHI_REQUIRE_LIMIT_ORDER=true
KALSHI_REQUIRE_FOK_OR_IOC=true
KALSHI_ALLOW_MARKET_ORDERS=false
KALSHI_LIVE_PRECHECK_TIMEOUT_MS=1000

# --- Localization / scheduling ---
LOCAL_TIMEZONE=Europe/Dublin
EOD_SUMMARY_TIME=00:00             # HH:MM local time for end-of-day summary

# --- Risk limits (set numeric values locally) ---
MAX_ORDER_SIZE=                    # max contracts/shares per single order
MAX_POSITION_PER_CONTRACT=         # max net position per contract
MAX_DAILY_LOSS=                    # max daily loss (account currency) before halt
MAX_OPEN_RISK=                     # max simultaneous open risk exposure
MAX_TRADES_PER_HOUR=               # rate limit on order submissions
PAPER_STARTING_BANKROLL=           # starting bankroll for paper mode

# --- Polymarket (PARKED / DORMANT — legacy BTC 5m reference; not the default) ---
# The Polymarket pipeline is parked due to account/funding issues. It is NOT part
# of the default pipeline; set POLYMARKET_DORMANT=false to run the legacy path.
POLYMARKET_DORMANT=true
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_WALLET_ADDRESS=

# --- BTC market data sources (public endpoints; NO credentials required) ---
# Coinbase spot + Binance USDT-M futures recording use PUBLIC REST endpoints over
# stdlib urllib. Endpoints are set in config/default.yaml (sources.*). No keys
# are needed for discovery, book recording, underlying recording, or backfill.
COINBASE_WS_URL=
BINANCE_FUTURES_WS_URL=

# --- Source freshness: LIVENESS vs DECISION freshness (SEPARATE, do not mix) ---
# LIVENESS = "is the collector alive?" (loose, ~60s). DECISION = "is this data fresh
# enough to score / emit a PAPER_CANDIDATE?" (strict, ~1s book / ~5s underlying). A
# collector can be ALIVE while its data is TOO STALE TO TRADE. Trading uses the
# DECISION thresholds — never the 60s liveness window. Never loosen these to get trades.
KALSHI_BOOK_LIVENESS_THRESHOLD_MS=60000
KALSHI_BOOK_DECISION_MAX_AGE_MS=1000
COINBASE_LIVENESS_THRESHOLD_MS=60000
COINBASE_DECISION_MAX_AGE_MS=5000
BINANCE_LIVENESS_THRESHOLD_MS=60000
BINANCE_DECISION_MAX_AGE_MS=5000
DERIBIT_LIVENESS_THRESHOLD_MS=180000
DERIBIT_DECISION_MAX_AGE_MS=180000
# Underlying group + Binance fallback (Coinbase primary; Binance stands in only when
# allowed AND itself decision-fresh). require_primary_for_entry forces Coinbase.
UNDERLYING_REQUIRE_ONE_FRESH=true
UNDERLYING_PRIMARY=coinbase
UNDERLYING_FALLBACK=binance
UNDERLYING_ALLOW_BINANCE_FALLBACK=true
UNDERLYING_REQUIRE_PRIMARY_FOR_ENTRY=false
UNDERLYING_REJECT_IF_BOTH_STALE=true
# Paper-candidate freshness gates — stale data must NEVER produce a PAPER_CANDIDATE.
KALSHI_REJECT_PAPER_IF_BOOK_STALE=true
KALSHI_REJECT_PAPER_IF_UNDERLYING_STALE=true
KALSHI_REJECT_PAPER_IF_FEATURE_ROW_STALE=true
KALSHI_FEATURE_ROW_MAX_AGE_MS=1000

# --- Deribit (OPTIONAL auxiliary vol/options regime source; NOT required) ---
# Native OPTIONAL source for BTC volatility/options/regime context (DVOL, index,
# historical vol, near-expiry/ATM IV, OI, put/call ratios, skew). NOT a trading
# venue. Disabled by default. Public REST reads need NO credentials; client_id/
# secret are only for private endpoints this project does not use. Joined into
# Kalshi feature rows POINT-IN-TIME with freshness flags; if disabled/stale/
# missing the Kalshi pipeline continues unaffected. Used only to widen uncertainty
# in high-vol regimes — never as a directional signal. Record with `record-deribit`.
# DERIBIT_ENABLED controls active collection / live source usage. Public REST reads
# need NO credentials; client_id/secret are only for private endpoints we do not use.
DERIBIT_ENABLED=false
DERIBIT_API_URL=https://www.deribit.com/api/v2
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
# Deribit is slow-moving context: poll infrequently (seconds) and treat a snapshot
# older than the stale threshold (seconds) as stale on the feature row.
DERIBIT_POLL_INTERVAL_SECONDS=30
DERIBIT_STALE_THRESHOLD_SECONDS=180
# DERIBIT_INCLUDE_IN_MODEL_FEATURES is a SEPARATE control from DERIBIT_ENABLED: it
# decides whether deribit_* columns enter the model CANDIDATE feature group. It
# defaults false and cannot silently become effective while Deribit is disabled —
# using leftover historical Deribit columns while disabled additionally requires
# DERIBIT_ALLOW_HISTORICAL_FEATURES_WHEN_DISABLED=true. So a disabled Deribit whose
# old columns linger in historical rows is never silently fed to the model.
DERIBIT_INCLUDE_IN_MODEL_FEATURES=false
DERIBIT_ALLOW_HISTORICAL_FEATURES_WHEN_DISABLED=false
# Record toggles for the optional Deribit raw/normalized JSONL streams.
DERIBIT_RECORD_RAW=true
DERIBIT_RECORD_NORMALIZED=true

# --- Chainlink Data Streams (OPTIONAL; the OFFICIAL settlement-grade source) ---
# Polymarket BTC 5m markets resolve from the Chainlink BTC/USD data stream. That
# API is authenticated and NOT public, so by default the system has NO official
# numeric price and keeps Coinbase/Binance values as PROVISIONAL_REFERENCE.
# Provide these locally (env-only; never paste in chat) to enable OFFICIAL lines
# via `backfill-official-chainlink`. Until set, numeric lines stay provisional.
CHAINLINK_STREAMS_API_KEY=
CHAINLINK_STREAMS_API_SECRET=
CHAINLINK_STREAMS_API_URL=https://api.dataengine.chain.link
CHAINLINK_BTC_FEED_ID=

# --- Pushover notifications (optional; Noop fallback if disabled/blank) ---
# Missing/disabled Pushover never breaks the system — it logs to console (Noop).
PUSHOVER_ENABLED=false
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_DEVICE=
PUSHOVER_PRIORITY=0
PUSHOVER_SOUND=
PUSHOVER_API_URL=https://api.pushover.net/1/messages.json
NOTIFY_EVENT_PREFIX=btc15m_kalshi

# --- Latency-safe async notifications (never block the decision/order path) ---
# The hot path ENQUEUES an event in-memory and returns immediately; a background
# worker performs the actual Pushover send. WATCH/REJECTED spam is coalesced.
NOTIFICATIONS_ASYNC_ENABLED=true
NOTIFICATIONS_QUEUE_MAXSIZE=500
NOTIFICATIONS_SEND_TIMEOUT_MS=750
NOTIFICATIONS_DROP_LOW_PRIORITY_WHEN_FULL=true
NOTIFICATIONS_COALESCE_WATCH=true
NOTIFICATIONS_HOTPATH_BLOCKING_FORBIDDEN=true

# --- Paths & logging ---
DATA_DIR=./data
REPORTS_DIR=./reports
LOG_LEVEL=INFO


<!-- HIRES-MEASUREMENT-LAYER -->

# --- High-resolution measurement layer (READ-ONLY; no orders, no paper/live) ---
# Sub-second Coinbase/Binance PUBLIC WebSocket + fast Kalshi active-book REST polling,
# recorded to SEPARATE data/{raw,normalized}/hires and data/features/hires paths so the
# repricing-lag hypothesis can be tested at fine resolution later. Disabled by default;
# record-only; HIRES_NO_ORDERS and HIRES_LIVE_SUBMISSION_ALLOWED are force-set in code.
KALSHI_HIRES_ENABLED=false
KALSHI_HIRES_MODE=record_only
KALSHI_HIRES_SERIES=KXBTC15M
KALSHI_HIRES_BOOK_SOURCE=rest            # rest | websocket | auto  (Kalshi WS needs auth -> REST)
KALSHI_HIRES_REST_POLL_MS=500
KALSHI_HIRES_REST_MIN_POLL_MS=250
KALSHI_HIRES_MAX_MARKETS=1
KALSHI_HIRES_ACTIVE_ONLY=true
KALSHI_HIRES_REDISCOVER_MS=1000
KALSHI_HIRES_BACKOFF_ON_ERROR_MS=2000
COINBASE_HIRES_ENABLED=true
COINBASE_HIRES_SOURCE=websocket          # websocket | rest | off
COINBASE_HIRES_SYMBOL=BTC-USD
BINANCE_HIRES_ENABLED=true
BINANCE_HIRES_SOURCE=websocket
BINANCE_HIRES_SYMBOL=BTCUSDT
HIRES_RECORD_RAW=true
HIRES_RECORD_NORMALIZED=true
HIRES_FLUSH_EVERY_MS=250
HIRES_MAX_RUNTIME_SECONDS=3600
HIRES_OUTPUT_PREFIX=hires
HIRES_NO_ORDERS=true                     # always enforced true in code
HIRES_LIVE_SUBMISSION_ALLOWED=false      # always enforced false in code


<!-- HIRES-HARDENING-1.5 -->

# --- High-resolution recorder hardening (Prompt 1.5) ---
HIRES_WRITER_MODE=threaded                 # sync | threaded (threaded = bounded queue + writer thread)
HIRES_QUEUE_MAXSIZE=100000
HIRES_QUEUE_WARN_SIZE=50000
HIRES_DROP_POLICY=drop_low_priority        # block | drop_low_priority | drop_oldest_low_priority
HIRES_ROTATE_EVERY_SECONDS=900
HIRES_COMPRESS_CLOSED_FILES=true
HIRES_COMPRESS_CODEC=gzip
HIRES_RETENTION_RAW_DAYS=7
HIRES_RETENTION_NORMALIZED_DAYS=30
HIRES_RETENTION_JOINED_DAYS=90
# Binance high-volume streams (aggTrade is HEAVY -> OFF by default; bookTicker is the firehose).
BINANCE_HIRES_BOOKTICKER_ENABLED=true
BINANCE_HIRES_AGGTRADE_ENABLED=false
BINANCE_HIRES_AGGTRADE_SAMPLE_EVERY_N=1
BINANCE_HIRES_MAX_MSGS_PER_SECOND=0        # 0 = no cap
# Joined snapshot cadence.
HIRES_JOINED_ON_KALSHI_UPDATE=true
HIRES_JOINED_MAX_HZ=5


<!-- KALSHI-WS-FEASIBILITY -->

# --- Kalshi market-data WebSocket (READ-ONLY feasibility; OPT-IN; auth-gated) ---
# Kalshi gates even market-data WS behind a key (unlike the public Coinbase/Binance feeds).
# These are READ-ONLY market-data credentials ONLY; never used to place orders. Leave unset to
# keep REST polling (the default). Tool output never prints these values (presence/booleans only).
KALSHI_USE_WEBSOCKET=false
# KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2   # default
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PASSPHRASE=
# Opt-in the read-only WS book source in the hi-res recorder (REST stays the fallback):
# KALSHI_HIRES_BOOK_SOURCE=websocket
